# ============================================================
# Visual Recipe 模型探针台 - 环境变量示例
# ------------------------------------------------------------
# 重要：本项目采用 BYOK（用户自带 Key）。
# - 火山方舟 API Key 由用户在浏览器“模型设置”中填写，
#   仅保存在浏览器 sessionStorage，关闭标签页即清除；
#   服务端/代理不保存、不记录 Key，也不需要在此配置 Key。
# - 因此本示例文件中【没有也不允许】填写任何真实密钥。
# - 复制为 .env 仅用于自部署时调整端口等非敏感项。
# ============================================================

# 独立静态+代理服务器（server/proxy-server.mjs）监听端口
PORT=5173

# Base URL 可在前端“模型设置”中修改，默认值（主机限火山官方域名 .volces.com，必须 https）：
# 兼容 OpenAI 接口协议： https://ark.cn-beijing.volces.com/api/v3
# 兼容 Anthropic 接口协议：https://ark.cn-beijing.volces.com/api/plan
# 说明：代理仍会拒绝指向任意外部主机的 Base URL（防 SSRF）。
